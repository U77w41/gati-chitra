{
  "name": "gati-chitra",
  "version": "0.10.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json && vite build",
    "check:dist": "node scripts/check-dist.mjs",
    "icons": "node scripts/make-icons.mjs",
    "lint": "oxlint --deny-warnings -D no-explicit-any -D no-unused-vars src scripts",
    "og": "node scripts/make-og.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@dagrejs/dagre": "^3.1.3",
    "@fontsource/lato": "^5.3.0",
    "gifenc": "^1.0.3",
    "mediabunny": "1.65.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "oxlint": "1.90.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
